@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "It's closed..."
@ TALK "What shall I do?"
@ WAIT
@ CLEAR_BUFFER
@ FACE 4 "Door keeper" 160 160 200
@ COLOR 160 160 200
@ TALK "Hey!"
@ TALK "Be quite. I'll let you in"
@ TALK "if you pay me 500 gold pieces."
@ TALK "Do you have the money?"
@ WAIT
@ CLEAR_BUFFER
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "<Yes>" GO_DOWN OK1
CASE "<No>" GO_DOWN END
SELECT_END
