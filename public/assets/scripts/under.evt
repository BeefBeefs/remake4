/마을5의 상점주인
# 2
# 8
# 2
# "Shopkeeper"
# BASIC
# 100
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ TALK "How are you? Can I help you?"
@ TALK "What do you need?"
@ WAIT
@ IF NUM HAVE 151 THEN GO_DOWN 산삼1
* 사주상점주인
@ CLEAR_BUFFER
@ BOX BLUE 6
@ COLOR 250 250 0
@ SELECT 250 250 255
CASE "Buying weapon" GO_DOWN 장비고르기1
CASE "Selling weapon" GO_DOWN 장비팔기
CASE "Buying item" GO_DOWN 아이템사기3
CASE "Selling Item" GO_DOWN 아이템팔기
CASE "Talking" GO_DOWN T5-2
CASE "<Exit>" GO_DOWN 끝
SELECT_END
@ END

* T5-2
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ SELECT 255 255 255
CASE "<Talking about the Devil>" GO_DOWN T5-A
CASE "<Talking about Satan's lieutenants>" GO_DOWN T5-B
CASE "<Talking about Raegios's family>" GO_DOWN T5-C
CASE "<Stop talking>" GO_UP 사주상점주인
SELECT_END
@ END

* T5-A
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ TALK "You know now that we are in the underworld"
@ TALK "I can tell there is no point humans and devils fighting" 
@ TALK "Humans would lose."
@ WAIT
@ CLEAR_BUFFER
@ TALK "Each of the demon war-lords is prepared to fight " 
@ TALK "to dominate the underworld."
@ TALK "If the devils got their power together" 
@ TALK "we humans would be wiped out."
@ WAIT
@ CLEAR_BUFFER
@ SELECT 255 255 255
CASE "<Satan's lieutenants>" GO_DOWN T5-A-1
SELECT_END
@ END

* T5-A-1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ TALK "According to the rumor when Satan was trapped down here"
@ TALK "There were two of his lieutenants... Western demons" 
@ TALK "and Estern demon. one who got Satan's eyes and"
@ TALK "one who got Satan's ears."
@ TALK "They are the strongest of all the devils."
@ WAIT
@ CLEAR_BUFFER
@ TALK "They were Satan's right-hand men but after he was"
@ TALK "trapped... they divided the world into two under their" 
@ TALK "control."
@ WAIT
@ GO_UP T5-2
@ END

* T5-B
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ TALK "Hmm...the devil...?"
@ TALK "Satan had the reputation as being the greatest devil"
@ TALK "but now maybe not."
@ TALK "According to the rumor"
@ TALK "he is living in forced retireEndless Cave"
@ TALK "...after giving his power to his underlings."
@ WAIT
@ CLEAR_BUFFER
@ TALK "On the other hand, a rumor says he got"
@ TALK "Shadow Sword in the world..."
@ TALK "and that gives him great power still."
@ WAIT
@ CLEAR_BUFFER
@ TALK "But why doesn't he use it?"
@ TALK "He hopes that the war-lords will fight each other"
@ TALK "and destroy themselves so that"
@ TALK "he is the sole power again."
@ WAIT
@ CLEAR_BUFFER
@ TALK "Do you know that the war-lords betrayed Satan"
@ TALK "right after they got his power?"
@ TALK "They want to keep him retired."
@ WAIT
@ GO_UP T5-2 

* T5-C
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ TALK "You means that Raegios's family is..."
@ TALK "Raedina and Raegios?"
@ WAIT
@ CLEAR_BUFFER
@ TALK "A witch Redina and wizard Raegios are under"
@ TALK "a spell cast by the Western demons and Eastern demon"
@ TALK "Demons were afraid of their power..."
@ TALK "Maybe the magicians were opposed "
@ TALK "to the demons attacking the world."
@ CLEAR_BUFFER
@ TALK "But now they've lost their power..."
@ TALK "And no one knows how the world is going to survive."
@ WAIT
@ GO_UP T5-2 


* 산삼1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "<Talking about wild ginseng>" GO_DOWN 산삼2
CASE "<Talking about goods>" GO_UP 사주상점주인
CASE "<Exit>" GO_DOWN 중계끝
SELECT_END

* 산삼2
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "Do you sell wild ginseng here?!"
@ TALK "I need some urgently..."
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ TALK "Wild ginseng?"
@ TALK "Wild ginseng... I have one root..."
@ TALK "But... It's hard to replace..."
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "Please!"
@ TALK "Help me!!"
@ TALK "It's for saving a girl's life."
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ TALK "Hmm... I can understand your situation but..."
@ TALK "It's so hard to get more of it, it's very valuable."
@ TALK "But if you pay 10,000 gold pieces..."
@ TALK "I could let you have it."
@ WAIT

@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "<Hand over the Money>" GO_DOWN 산삼1-1
CASE "<Don't give Money>" GO_DOWN 산삼1-2
SELECT_END

* 산삼1-1
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ IF MONEY GE 10000 THEN GO_DOWN 산삼OK
@ TALK "What... You try and cheat me! You have no money..."
@ TALK "You want to buy something? With no money?"
@ TALK "Are you kidding?"
@ TALK "Get out of here... Right now!"
@ WAIT
@ END

* 산삼1-2
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ TALK "I can't help it if you don't like it..."
@ TALK "Please don't bad mouth me!"
@ TALK "It's only natural for a merchant to want to"
@ TALK "make a profit."
@ TALK "See you another time!"
@ WAIT
@ END

* 산삼OK
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ REMOVE MONEY 10000
@ GIVE ITEM 168 1
@ TALK "Here! It's wild ginseng!"
@ TALK "You know... It's almost too good to sell...."
@ TALK "It's really hard to get..."
@ TALK "Anyway here it's. I hope it's going to be useful..."
@ TALK "It's such an expensive thing."
@ REMOVE NUM_TO_ALL 151
@ WAIT
@ END

