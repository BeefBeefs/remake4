* 사주마녀
@ CLEAR_BUFFER
@ COLOR 240 20 190
@ IF LEARN_MAGIC THEN GO_DOWN MAGIC_STOP
@ BOX BLUE 5
@ FACE 6 "A witch at her magical encamp Endless Cave" 240 20 190
@ TALK "What can I do for you?"
@ WAIT
@ CLEAR_BUFFER
@ COLOR 250 250 0
@ SELECT 250 250 250
CASE "Talking" GO_DOWN T5-3
CASE "Training in witchcraft" GO_DOWN 마법훈련1
CASE "<Exit>" GO_DOWN 끝
SELECT_END

* T5-3
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 6 "A Witch at her magical encamp Endless Cave" 240 20 190
@ COLOR 240 20 190
@ TALK "You're asking me first without paying me anything..."
@ TALK "OK...Whatever. It doesn't matter."
@ TALK "What do you need?"
@ WAIT

* T5-3A
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 6 "A Witch at her magical encampment" 240 20 190
@ COLOR 240 20 190
@ SELECT 255 255 255
CASE "<About Western demon>" GO_DOWN T5-3-1
CASE "<About Eastern demon>" GO_DOWN T5-3-2
CASE "<Talking about Raegios's Family>" GO_DOWN T5-3-3
CASE "<Stop talking>" GO_UP 사주마녀
SELECT_END
@END

* T5-3-1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 6 "A witch at her magical encampment" 240 20 190
@ COLOR 240 20 190
@ TALK "The Western demon lives in the Castle of the West."
@ TALK "In order to get there you must go through a cave"
@ TALK "full of bats"
@ TALK "which opens into a lava tube from the volcano."
@ TALK "But devils block the way"
@ TALK "so it's not easy to get through."
@ WAIT
@ GO_UP T5-3A 

* T5-3-2
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 6 "A witch at her magical encampment" 240 20 190
@ COLOR 240 20 190
@ TALK "I don't know what I can tell you about this demon..."
@ TALK "The Eastern demon has great influence" 
@ TALK "in the east. If you want to reach him, go through" 
@ TALK "the Pandemonium Cave in the northeastern part of"
@ TALK "the East village."
@ TALK "But be careful, devils block the way."
@ WAIT
@ GO_UP T5-3A

* T5-3-3
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 6 "A witch at her magical encampment" 240 20 190
@ COLOR 240 20 190
@ TALK "So, you want to know about Raegios's family?"
@ TALK "Raegios's family are magicians... " 
@ TALK "I can't say anything about that family" 
@ TALK "without mentioning my friend Raedina."
@ WAIT
@ CLEAR_BUFFER
@ TALK "As a witch her disposition and magics were..."
@ TALK "so reverential..."
@ WAIT
@ TALK "But now she and her family...they are under a spell..."
@ WAIT
@ CLEAR_BUFFER
@ TALK "I don't want to talk about that... It upsets me!"
@ WAIT
@ GO_UP T5-3A

