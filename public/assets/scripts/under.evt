* 아이템상인명령1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 5 "Item merchant" 250 200 0
@ COLOR 250 200 0
@ TALK "How are you? What can I do for you?"
@ TALK "I'll help you find what you need."
@ WAIT
* 사주아이템
@ CLEAR_BUFFER
@ BOX BLUE 5
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "Buying item" GO_DOWN 아이템사기2
CASE "Selling item" GO_DOWN 아이템팔기
CASE "Talking" GO_DOWN 사주아이템T-1
CASE "Exit" GO_DOWN 끝
SELECT_END

* 사주아이템T-1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 5 "Item merchant" 250 200 0
@ COLOR 250 200 0
@ TALK "I think you are from outside, the world,"
@ TALK "aren't you?"
@ TALK "I knew that at first sight... But it's wise" 
@ TALK "to be careful. I don't know why you're here..."
@ TALK "But it's not easy to exist here..."
@ WAIT
@ CLEAR_BUFFER
@ TALK "Only strong devils are here in the underworld."
@ TALK "The weak devils are outside in the world."
@ TALK "Nowadays they are very touchy because"
@ TALK "there is feuding amongst them..."
@ WAIT
@ CLEAR_BUFFER
@ TALK "If it's possible it'd be better for you to go back"
@ TALK "to the world."
@ WAIT
@ GO_UP 사주아이템
