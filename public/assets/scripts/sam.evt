# 1
# 1
# 1
# "Blacksmith"
# BASIC
# 100
/장비만 취급하는 대장간. 비선마을. 동방마을
@ CLEAR_BUFFER
@ BOX BLUE 6
@ FACE 8 "Blacksmith" 200 250 0
@ COLOR 200 250 0
@ TALK "Do you need any Weapons? Any Repairs?"
@ TALK "I buy and sell weapons."
@ TALK " "
* 대장장이명령
@ CLEAR_BUFFER
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "Select weapon" GO_DOWN 장비고르기2
CASE "Sell weapon" GO_DOWN 장비팔기
CASE "Repair weapon" GO_DOWN 장비수리
CASE "Talk" GO_DOWN T1-1
CASE "Exit" GO_DOWN 끝

SELECT_END

* T1-1
/* 대장장이와 대화
@ CLEAR_BUFFER
@ BOX BLUE 6
@ SELECT 255 255 255
CASE "<About the World>" GO_DOWN T1-1-1
CASE "<About the Blood Sword>" GO_DOWN T1-1-3
CASE ""
CASE "<Stop Talking>" GO_DOWN END
SELECT_END
@ END
* T1-1-1
@ CLEAR_BUFFER
@ COLOR 200 200 0
@ TALK "Demons are appearing near this village."
@ TALK "We are afraid they will try to kill us!"
@ WAIT
@ CLEAR_BUFFER
@ BOX BLUE 6
@ TALK "Yes, we could hire somebody to protect us, but..."      
@ TALK "Could they protect us from these demons?"
@ TALK "Hiring warriors is very expensive." 
@ TALK "I would fight them myself if I were younger.."
@ WAIT
@ IF ITEM NOTHAVE 220 THEN GO_DOWN TA        
@ CLEAR_BUFFER
@ BOX BLUE 6
* STEP1
@ SELECT 255 255 255
CASE "<About demon hunters>" GO_DOWN TA
CASE "<About the sword I have>" GO_DOWN T1-1E-B
SELECT_END
@ END
* TA
@ CLEAR_BUFFER
@ BOX BLUE 6
@ TALK "I have seen many villagers killed by the Demons..."
@ TALK ""
@ TALK "Are you here to fight them?"
@ WAIT
@ CLEAR_BUFFER
@ TALK "Demons are everywhere!"
@ TALK "I'm not sure anyone survived.."
@ TALK "after they went to Dragon Valley"
@ TALK "No one ever returns from Dragon Valley"
@ WAIT
@ GO_UP T1-1
@ END
* T1-1-3
@ CLEAR_BUFFER
@ TALK "The Blood Sword..." 
@ TALK "The Blacksmith may know about it."
@ TALK "If you seek the sword one thing is certain..."
@ TALK "you will see a lot of BLOOD"
@ WAIT
@ CLEAR_BUFFER
@ TALK "I know about blood, I myself once killed some demons"
@ TALK "People know about my heroic deeds."
@ WAIT
@ CLEAR_BUFFER
@ TALK "Do you want to hear about the Blood Sword?"
@ TALK "The Blood Sword is ..."
@ TALK "It's a haunted sword."
@ TALK "I can't tell you anything more."
@ WAIT
@ TALK ""
@ TALK ""
@ SELECT 255 255 255
CASE "<About the Blood Sword>" GO_DOWN TA2
CASE "<About the Underworld>" GO_DOWN SS11
SELECT_END
* SS11
@ TALK "Where is the entrance to the underworld?"
@ TALK "If you are crazy enough to go there..."
@ TALK "to go in and try to kill Satan..."
@ TALK "you'll need the Blood Sword" 
@ WAIT
@ CLEAR_BUFFER
@ TALK "The Blood Sword can kill Satan."
@ TALK "You must find the Blood Sword"
@ TALK "if you really want to win the war"
@ TALK "against the Demons"
@ WAIT
@ GO_UP T1-1
* TA2
@ CLEAR_BUFFER
@ TALK "You must know about the Blood sword..."
@ TALK ""
@ WAIT
@ CLEAR_BUFFER
@ TALK "So, be nice to me, young man!"
@ TALK "There is something you can do for me."
@ TALK "Buy something from me!" 
@ WAIT
@ CLEAR_BUFFER
@ TALK "Hmm.."
@ TALK "Perhaps you will buy some of my goods?" 
@ TALK "Then I will tell you more about the sword."
@ WAIT
@ CLEAR_BUFFER
@ TALK "Well, where shall I begin?"
@ TALK "Ah... yes! Many heroes want to find the Blood"
@ TALK "Sword but it's hard to find."
@ TALK "Many years ago the Blood Sword was"
@ TALK "broken in half during the battle"
@ TALK "against a Ghost envoy."
@ TALK "After the fight, one half of the Blood Sword"
@ TALK "disappeared! It's called Shadow Sword.."
@ WAIT
@ CLEAR_BUFFER
@ TALK "The other half of the Blood Sword, however,"
@ TALK "is powerful enough to kill Satan" 
@ TALK "It possesses an evil power to kill demons"
@ TALK "This is the only hope you have"
@ TALK "to vanquish the Demons"
@ TALK "Kill the Prince of Demons with the Evil Sword!"
@ TALK "I hope you understand..."
@ WAIT
@ GO_UP T1-1
@ END
* T1-1E-B
@ CLEAR_BUFFER
@ TALK "Ah! you have a rare old sword"
@ TALK "Is it a family heirloom?"
@ TALK "Hmm... This heirloom..."
@ WAIT
@ CLEAR_BUFFER
@ TALK "It's very old fashioned style of sword..."
@ TALK "..."
@ TALK "" 
@ TALK "It may be an heirloom, but its way too old..."
@ TALK "It's nothing but junk. Scrap metal."
@ TALK "It's useless for fighting with."
@ WAIT
@ CLEAR_BUFFER
@ TALK "You should get a new sword!"
@ TALK "I'll sell you one at a good price."
@ WAIT
@ GO_UP 대장장이명령
@ END


