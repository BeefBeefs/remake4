@ CLEAR_BUFFER
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "Don't worry. I'll get it" GO_DOWN END
CASE "About what?" GO_DOWN T1
CASE "I have not complete yet." GO_BASIC_EVENT
SELECT_END
@ END

