@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "Throw in money" GO_DOWN T1
CASE "Drink the water" GO_DOWN T2
CASE "Cast a spell" GO_DOWN T4
SELECT_END
* T1
@ CLEAR_BUFFER
@ IF MONEY LE 9 THEN GO_DOWN NO1
@ CLEAR_BUFFER
@ COLOR 250 250 0
@ TALK "Live long and prosper."
@ REMOVE MONEY 10
@ PLAY COIN.WAV
@ WAIT
@ END
* NO1
@ CLEAR_BUFFER
@ COLOR 250 250 0
@ TALK "Oh! I don't have much money."
@ WAIT
@ END
* T2
@ CLEAR_BUFFER
@ COLOR 250 250 0
@ TALK "U... ughh Its filthy."
@ TALK "I've never seen such dirty water as this."
@ WAIT
@ END
* T4
@ IF NUM NOTHAVE 114 THEN GO_DOWN NO2
@ CLEAR_BUFFER
@ TALK "Do I make an incantation?"
@ SELECT 255 255 255
CASE "Blood of warriors make a river" GO_DOWN T3
CASE "Hero's footstep call swift horse" GO_DOWN T4
CASE "Strong warrior's power call you" GO_DOWN T5
SELECT_END
* NO2
@ CLEAR_BUFFER
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "What is the incantation? I must know it..."
@ TALK "I hope I know it."
@ WAIT
@ END
* T3
@ IF MAGIC LE 50 THEN GO_DOWN N1
@ WARP 22 53 13
@ END
* T4
@ IF MAGIC LE 45 THEN GO_DOWN N1
@ WARP 21 40 14
@ END
* T5
@ IF MAGIC LE 65 THEN GO_DOWN N1
@ WARP 20 19 19
@ END
* N1
@ CLEAR_BUFFER
@ FACE NO
@ BOX RED 3
@ COLOR 255 60 60
@ TALK "Your magic is not completed."
@ WAIT
@ END



=========================================================
    / 북괴성 마녀에 대한 비리 캐기
=========================================================
117  : 사람을 개골 동굴로 보내서 죽게하는 북괴성 마을의 마녀에 대한 이벤트
   119년. 북괴성 마을의 보석상.
   마물들과 짜고서 개골 동굴로 보내는 마녀에 대한 이야기.
   그 마녀를 이 마을에서 없애달라.
  ORDER 117. NUM_TO_ALL 117
# 117
# 17
# 7
# "Jeweler"
# FLOW
# 119
@ IF NUM HAVE 117 && ORDER NOTHAVE 117 THEN GO_BASIC_EVENT
@ IF ORDER HAVE 117 THEN GO_DOWN NEXT1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ TALK "Do you want information?"
@ TALK " "
@ SELECT 255 255 255
CASE "About the village" GO_DOWN STEP1
CASE "About products" GO_BASIC_EVENT
SELECT_END

* STEP1
@ IF ORDER HAVE 117 THEN GO_DOWN NEXT1
@ IF NUM HAVE 26 THEN GO_DOWN NEXT2
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 11 "Jeweler" 210 210 210
@ COLOR 210 210 210
@ TALK "The witch over there is casting evil spells."
@ TALK "I've heard she kills warriors that she trains."
@ TALK "I saw her talking with demons."
@ TALK "Go and try to find out who she is and kill her."
@ TALK "She has the face of an angel"
@ TALK "but, she's really an accomplice of the demons."
@ WAIT
@ CLEAR_BUFFER
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "I'll find out who she is." GO_DOWN T1
CASE "I'm not interested in her." GO_DOWN END
SELECT_END

* NEXT2
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 11 "Jeweler" 210 210 210
@ COLOR 210 210 210
@ TALK "That witch has gone."
@ TALK "Thank you very much."
@ TALK "I want to thank you by paying you money."
@ TALK "Here's 3,735 gold pieces. Please accept it."
@ GIVE MONEY 3735
@ WAIT
@ CHANGE 0
@ END

* NEXT1
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 11 "Jeweler" 210 210 210
@ COLOR 210 210 210
@ TALK "Did you discover the witch's identity?"
@ TALK "I think she's an evil witch."
@ WAIT
@ GO_BASIC_EVENT
@ END

* T1
@ CLEAR_BUFFER
@ FACE 11 "Jeweler" 210 210 210
@ COLOR 210 210 210
@ TALK "You are such a great warrior."
@ TALK "Please protect our village from the witch."
@ WAIT
@ CLEAR_BUFFER
@ IF ORDER HAVE 117 THEN GO_DOWN END
@ FACE HERO 250 250 0
@ COLOR 250 250 0
@ SELECT 255 255 255
CASE "OK! I'll do it" GO_DOWN OK1
CASE "I'm sorry... I will not" GO_DOWN END
CASE "I'm here for other work" GO_BASIC_EVENT
SELECT_END

* OK1
@ CLEAR_BUFFER
@ FACE 11 "Jeweler" 210 210 210
@ COLOR 210 210 210
@ TALK "Thank you..."
@ IF ORDER_SPACE NOTHAVE THEN GO_DOWN NO_SPACE
@ ORDER 117 "Prove witch's identity at Stone village."
MENT "Feel suspicious about the witch."
MENT "Go and find out who she is."
ORDER_END
@ GIVE NUM_TO_ALL 117
@ WAIT
@ END



