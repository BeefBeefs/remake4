# BASIC
# 100
/모든 물건 사고 파는 상점
@ CLEAR_BUFFER
@ BOX BLUE 5
@ FACE 7 "Shopkeeper" 250 220 0
@ COLOR 250 220 0
@ TALK "We have everything you need here!"
@ TALK "Just tell me what you're looking for."
@ CLEAR_BUFFER
@ COLOR 250 250 0
@ SELECT 250 250 255
CASE "Select weapon" GO_DOWN 장비고르기1
CASE "Sell weapon" GO_DOWN 장비팔기
CASE "Buy item" GO_DOWN 아이템사기3
CASE "Sell item" GO_DOWN 아이템팔기
CASE "Exit" GO_DOWN 끝
SELECT_END

